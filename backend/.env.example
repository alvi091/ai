PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_buying_agent"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your-gemini-api-key
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
AMAZON_COUNTRY=US
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Queue mode activates automatically when REDIS_URL is set (production).
REDIS_URL=
ANALYZE_QUEUE_ENABLED=true
ANALYZE_INLINE_MAX=3
ANALYZE_WORKER_CONCURRENCY=3
ANALYZE_GLOBAL_MAX=16
ANALYSIS_CACHE_TTL_MS=43200000
# Deep review fetch limits — 0 = fetch ALL written comments.
# MYNTRA_MAX_REVIEWS=60   # 60 = cap reviews for speed; 0 = fetch ALL (slower, 2-3 min on Flipkart)
# FLIPKART_MAX_REVIEWS=60  # 60 = cap reviews for speed; 0 = fetch ALL (can take 30+ min due to 5s API pacing)
# AMAZON_MAX_REVIEWS=0
# AJIO_MAX_REVIEWS=0
# NYKAA_MAX_REVIEWS=0
# MEESHO_MAX_REVIEWS=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
