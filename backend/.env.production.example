# =============================================================
# AI Buying Agent — Backend PRODUCTION environment template
# Use this ONLY as a reference. Paste the real values into the
# Render dashboard (Service -> Environment). Never commit secrets.
# =============================================================

NODE_ENV=production
PORT=5000

# -------------------------------------------------------------
# Supabase PostgreSQL
# Supabase Dashboard -> Project Settings -> Database ->
#   "Connection string (URI)" (direct connection, port 5432)
# IMPORTANT: keep ?sslmode=require at the end — Supabase requires SSL
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth — use a long random string (Render can auto-generate one)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (Gemini is the default used by the app)
GEMINI_API_KEY=your-google-ai-studio-key

# CORS — only matters for the web frontend (set to your web app URL)
CORS_ORIGIN=https://your-web-app.onrender.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -------------------------------------------------------------
# Queue + worker fleet (Render Redis). Set REDIS_URL on BOTH the
# web and worker services. With REDIS_URL present, POST /api/analyze
# enqueues a job and returns { jobId }; the frontend polls automatically.
# Without it (local dev) analysis runs inline with ANALYZE_INLINE_MAX cap.
# -------------------------------------------------------------
REDIS_URL=redis://default:your-redis-password@your-redis-render.internal:6379
# Use the queue even when Redis is configured (set to false to force inline)
ANALYZE_QUEUE_ENABLED=true
# Cap on concurrent INLINE analyses per web instance (saturates with 429)
ANALYZE_INLINE_MAX=3
# Concurrency per WORKER instance (browsers/crawls are memory heavy)
ANALYZE_WORKER_CONCURRENCY=3
# Best-effort cap on ACTIVE analyses across ALL worker instances (Redis)
ANALYZE_GLOBAL_MAX=16
# How long a cached report stays fresh before the same URL is re-crawled
ANALYSIS_CACHE_TTL_MS=43200000

# Node heap guard (set on 2-4GB worker instances)
# NODE_OPTIONS=--max-old-space-size=2048

# Deep review fetch limits — 0 = fetch ALL written comments.
# MYNTRA_MAX_REVIEWS=0
# FLIPKART_MAX_REVIEWS=0
# AMAZON_MAX_REVIEWS=0
# AJIO_MAX_REVIEWS=0
# NYKAA_MAX_REVIEWS=0
# MEESHO_MAX_REVIEWS=0

# SMTP — only needed if email / password reset is used
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
