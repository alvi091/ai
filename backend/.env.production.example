# =============================================================
# Ayymus — Backend PRODUCTION environment template (Google Cloud)
# Reference only. Real values live in Secret Manager and are bound
# to Cloud Run with --update-secrets / --set-env-vars.
# Never commit secrets.
# =============================================================

NODE_ENV=production
PORT=8080

# -------------------------------------------------------------
# Cloud SQL for PostgreSQL (ayymus-db)
# Cloud SQL Auth Proxy sidecar on Cloud Run (--add-cloudsql-instances).
# Socket form (private, recommended):
#   postgresql://ayymus_user:<password>@/ayymus?host=/cloudsql/PROJECT:REGION:INSTANCE
# Or public IP + TLS:
#   postgresql://ayymus_user:<password>@<IP>:5432/ayymus?sslmode=require
# -------------------------------------------------------------
DATABASE_URL="postgresql://ayymus_user:<password>@/ayymus?host=/cloudsql/pelagic-cycle-472614-h5:asia-south1:ayymus-db"

# Auth — long random string (Secret Manager)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (Gemini is the default used by the app)
GEMINI_API_KEY=your-google-ai-studio-key

# CORS — extra origins only (comma-separated). The SPA is served by this
# service (same-origin), so it never needs to be listed.
CORS_ORIGIN=https://ayymus.com

# Rate limiting (Memorystore store when REDIS_URL is set, else in-memory)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

# Memorystore Redis via the VPC connector (private IP)
REDIS_URL=redis://:<password>@10.x.x.x:6379

# -------------------------------------------------------------
# Queue + worker (Cloud Tasks)
# Set on the API service:
#   CLOUD_TASKS_QUEUE      — projects/<pid>/locations/<region>/queues/<name>
#   CLOUD_TASKS_WORKER_URL — https://ayymus-worker-xxxx.a.run.app
#   CLOUD_TASKS_OIDC_SA    — service account used to call the private worker
# Worker service gets DATABASE_URL + GEMINI_API_KEY (+ REDIS_URL optional).
# -------------------------------------------------------------
CLOUD_TASKS_QUEUE=projects/pelagic-cycle-472614-h5/locations/asia-south1/queues/ayymus-analyze
CLOUD_TASKS_WORKER_URL=https://ayymus-worker-xxxx.a.run.app
CLOUD_TASKS_OIDC_SA=<sa-name>@pelagic-cycle-472614-h5.iam.gserviceaccount.com
# Optional extra check on the worker (sent as x-tasks-secret header)
# TASKS_SHARED_SECRET=

# Use the queue even when configured (set to false to force inline)
ANALYZE_QUEUE_ENABLED=true
# Cap on concurrent INLINE analyses per API instance (saturates with 429)
ANALYZE_INLINE_MAX=2
# Concurrency per WORKER instance (browsers/crawls are memory heavy)
ANALYZE_WORKER_CONCURRENCY=3
# Cap on ACTIVE analyses per worker instance
ANALYZE_GLOBAL_MAX=6
# How long a cached report stays fresh before the same URL is re-crawled
ANALYSIS_CACHE_TTL_MS=43200000

# Node heap guard (set on 2-4GB instances)
NODE_OPTIONS=--max-old-space-size=2048

# Chromium (baked into the images; path set in the Dockerfiles)
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# SPA location inside the API container (default matches the Dockerfile)
# FRONTEND_DIST_PATH=/app/frontend/dist

# Deep review fetch limits — 0 = fetch ALL written comments.
FLIPKART_MAX_REVIEWS=60
MYNTRA_MAX_REVIEWS=60
# AMAZON_MAX_REVIEWS=0
# AJIO_MAX_REVIEWS=0
# NYKAA_MAX_REVIEWS=0
# MEESHO_MAX_REVIEWS=0

# SMTP — only needed if email / password reset is used
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Bright Data (optional)
# WEB_UNLOCKER_KEY=
# WEB_UNLOCKER_ZONE=ayymus
# SERP_API_KEY=
# SERP_API_ZONE=serp_api1
