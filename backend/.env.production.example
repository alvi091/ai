# =============================================================
# AI Buying Agent — Backend PRODUCTION environment template
# Use this ONLY as a reference. Paste the real values into the
# Render dashboard (Service -> Environment). Never commit secrets.
# =============================================================

NODE_ENV=production
PORT=5000

# -------------------------------------------------------------
# Supabase PostgreSQL
# Supabase Dashboard -> Project Settings -> Database ->
#   "Connection string (URI)" (direct connection, port 5432)
# IMPORTANT: keep ?sslmode=require at the end — Supabase requires SSL
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth — use a long random string (Render can auto-generate one)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider (Gemini is the default used by the app)
GEMINI_API_KEY=your-google-ai-studio-key

# CORS — only matters for the web frontend (set to your web app URL)
CORS_ORIGIN=https://your-web-app.onrender.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMTP — only needed if email / password reset is used
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
